package {{.Feature}}

import (
	"context"

	{{.AppAlias}} "{{.Module}}/internal/application/{{.Domain}}/{{.Feature}}"
	"{{.Module}}/internal/infrastructure/http/{{.Domain}}/{{.Feature}}/dto"
	"github.com/wssto2/go-core/pagination"
	"github.com/wssto2/go-core/route"
	"github.com/wssto2/go-core/web"
	"github.com/wssto2/go-core/web/typed"
)

type handler struct {
	service {{.AppAlias}}.Service
}

// Routes binds the handlers of Contract to the service; hand them to gocore.App.Routes.
func Routes(service {{.AppAlias}}.Service) []route.Handled {
	h := &handler{service: service}

	return []route.Handled{List.To(h.list), Show.To(h.show), Create.To(h.create)}
}

func (h *handler) list(ctx context.Context, _ ListRequest) (route.Page[dto.{{.Entity}}Response], error) {
	records, err := h.service.List(ctx)
	if err != nil {
		return route.Page[dto.{{.Entity}}Response]{}, err
	}

	rows := dto.From{{.Entity}}List(records)
	n := len(rows)

	// Scaffold: one page with every row. Take the page from the request (web.PageFromValues over the input's Query)
	// once the repository pages.
	return typed.ToPage(&pagination.PageResult[dto.{{.Entity}}Response]{
		Items: rows, Total: int64(n), PerPage: n, Page: 1, LastPage: 1, From: min(n, 1), To: n,
	}), nil
}

func (h *handler) show(ctx context.Context, in {{.Entity}}Path) (dto.{{.Entity}}Response, error) {
	if err := web.PositiveID("id", in.ID); err != nil {
		return dto.{{.Entity}}Response{}, err
	}

	return web.Mapped(dto.From{{.Entity}})(h.service.Get(ctx, in.ID))
}

func (h *handler) create(ctx context.Context, in {{.AppAlias}}.{{.InputType}}) (dto.{{.Entity}}Response, error) {
	who, err := web.SignedIn(ctx)
	if err != nil {
		return dto.{{.Entity}}Response{}, err
	}

	return web.Mapped(dto.From{{.Entity}})(h.service.Create(ctx, in, who))
}
