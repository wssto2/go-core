package note

import (
	"strings"

	"github.com/wssto2/go-core/validation"
)

// CreateNoteInput is the request body for creating a note record.
//
// Scaffold: every string field carries a max: bound sized to its column; keep
// that as fields grow.
type CreateNoteInput struct {
	Name string `json:"name" validation:"required|max:150"`
}

// Validate runs the struct's validation: tags.
func (i *CreateNoteInput) Validate() error {
	return validation.ValidateInput(i)
}

// Sanitize trims leading and trailing whitespace from user-supplied strings.
func (i *CreateNoteInput) Sanitize() {
	i.Name = strings.TrimSpace(i.Name)
}
