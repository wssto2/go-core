// Package dto holds the HTTP wire shapes for the note endpoints. The
// domain entity never crosses the wire directly: map it here.
package dto

import (
	"time"

	domainnote "example.com/shop/internal/domain/crm/note"
)

// NoteResponse is the wire shape of domainnote.Note.
type NoteResponse struct {
	ID        int        `json:"id"`
	Name      string     `json:"name"`
	CreatedBy int        `json:"created_by"`
	CreatedAt *time.Time `json:"created_at"`
	UpdatedAt *time.Time `json:"updated_at"`
}

// FromNote projects a domain note record onto its wire shape.
func FromNote(record domainnote.Note) NoteResponse {
	return NoteResponse{
		ID:        record.ID,
		Name:      record.Name,
		CreatedBy: record.CreatedBy,
		CreatedAt: record.CreatedAt,
		UpdatedAt: record.UpdatedAt,
	}
}

// FromNoteList projects a slice of domain note records onto their
// wire shape.
func FromNoteList(records []domainnote.Note) []NoteResponse {
	out := make([]NoteResponse, 0, len(records))
	for _, record := range records {
		out = append(out, FromNote(record))
	}

	return out
}
